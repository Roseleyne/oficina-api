                "veiculos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"BRA2E20\",\n  \"marca\": \"Fiat\",\n  \"modelo\": \"Argo\",\n  \"ano\": 2022,\n  \"clienteId\": 1\n}"
            }
          }
        },
        {
          "name": "Serviços - listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicos"
              ]
            }
          }
        },
        {
          "name": "Peças - listar",
          "request": {
            "method": "GET",
