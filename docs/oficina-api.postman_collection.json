{
  "info": {
    "name": "Oficina API - Tech Challenge Fase 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection completa da Oficina API. Rode 'Login' primeiro: o token JWT é salvo automaticamente. Para o webhook, preencha a variável webhookToken (kubectl get secret oficina-secret -n oficina -o jsonpath='{.data.WEBHOOK_TOKEN}' | base64 -d; no docker-compose: dev-webhook-token)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "osId",
      "value": "1"
    },
    {
      "key": "webhookToken",
      "value": "dev-webhook-token"
    }
  ],
  "item": [
    {
      "name": "0 - Autenticação e Saúde",
      "item": [
        {
          "name": "Login (salva token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"Admin@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1 - Fase 2: Ordem de Serviço",
      "item": [
        {
          "name": "Abrir OS completa (salva osId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/completa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "completa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": {\n    \"nome\": \"Carlos Andrade\",\n    \"cpfCnpj\": \"52998224725\",\n    \"email\": \"carlos@email.com\",\n    \"telefone\": \"11977776666\"\n  },\n  \"veiculo\": {\n    \"placa\": \"QWE1A23\",\n    \"marca\": \"Chevrolet\",\n    \"modelo\": \"Onix\",\n    \"ano\": 2023\n  },\n  \"descricaoProblema\": \"Barulho no freio dianteiro\",\n  \"servicos\": [\n    {\n      \"servicoId\": 1\n    }\n  ],\n  \"pecas\": [\n    {\n      \"pecaId\": 1,\n      \"quantidade\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('osId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar status da OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Listar OS (priorizada, sem encerradas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            }
          }
        },
        {
          "name": "Webhook - aprovar orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Token",
                "value": "{{webhookToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/orcamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "orcamento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordemServicoId\": {{osId}},\n  \"aprovado\": true,\n  \"observacao\": \"Cliente aprovou pelo link\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Webhook - recusar orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Token",
                "value": "{{webhookToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/orcamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "orcamento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordemServicoId\": {{osId}},\n  \"aprovado\": false\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Iniciar execução",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_EXECUCAO\"\n}"
            }
          }
        },
        {
          "name": "Finalizar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FINALIZADA\"\n}"
            }
          }
        },
        {
          "name": "Entregar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ENTREGUE\"\n}"
            }
          }
        },
        {
          "name": "Buscar OS por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}"
              ]
            }
          }
        },
        {
          "name": "Relatório tempo médio de execução",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/relatorios/tempo-medio-execucao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "relatorios",
                "tempo-medio-execucao"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 - Fluxo Fase 1 (passo a passo)",
      "item": [
        {
          "name": "Abrir OS (veículo existente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"veiculoId\": 1,\n  \"descricaoProblema\": \"Motor falhando\"\n}"
            }
          }
        },
        {
          "name": "Mover para diagnóstico",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_DIAGNOSTICO\"\n}"
            }
          }
        },
        {
          "name": "Adicionar serviço",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "servicos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicoId\": 1\n}"
            }
          }
        },
        {
          "name": "Adicionar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "pecas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": 1,\n  \"quantidade\": 1\n}"
            }
          }
        },
        {
          "name": "Aguardar aprovação",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AGUARDANDO_APROVACAO\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3 - Cadastros",
      "item": [
        {
          "name": "Clientes - listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            }
          }
        },
        {
          "name": "Clientes - criar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"cpfCnpj\": \"11144477735\",\n  \"email\": \"ana@email.com\",\n  \"telefone\": \"11988887777\"\n}"
            }
          }
        },
        {
          "name": "Veículos - listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/veiculos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "veiculos"
              ]
            }
          }
        },
        {
          "name": "Veículos - criar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/veiculos",
              "host": [
                "{{baseUrl}}"
              ],
