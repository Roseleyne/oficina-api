              "raw": "{{baseUrl}}/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pecas"
              ]
            }
          }
        },
        {
          "name": "Peças - entrada de estoque",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pecas/1/estoque/entrada",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
